{
  "name": "shared-password-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./src/api/index.ts",
    "./context": "./src/context/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*": "./src/hooks/*",
    "./models": "./src/models/index.ts",
    "./ui": "./src/components/index.ts",
    "./ui/*": "./src/components/*",
    "./utils": "./src/utils/index.ts",
    "./src/*": "./src/*",
    "./theme": "./src/styles/theme.css"
  },
  "scripts": {
    "clean": "npx rimraf dist coverage",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "api:generate": "openapi-generator-cli generate -i http://localhost:3000/api-json -g typescript-fetch -o ./src/api/pswapi --additional-properties=typescriptThreePlus=true,modelPropertyNaming=camelCase",
    "api:clean": "rm -rf ./src/api/pswapi",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^1.8.0",
    "qrcode": "^1.5.4",
    "react-responsive": "^10.0.1",
    "socket.io-client": "^4.8.3",
    "react-router": "^7.14.2"
  },
  "peerDependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@openapitools/openapi-generator-cli": "^2.30.2",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.0.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.4",
    "vitest-browser-react": "^2.2.0"
  }
}
